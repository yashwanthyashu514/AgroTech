# Environment Variables Template for Karnataka Agriculture AI Agent
PROJECT_NAME="AgroTech Karnataka AI Agent"
ENVIRONMENT=production
DEBUG=false

# Backend API
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database
DB_USER=agrotech_admin
DB_PASSWORD=agrotech_secure_pass_2026
DB_NAME=agrotech_db
